[Unit]
Description=Caddy public reverse proxy
After=network-online.target webserver-network.service webserver-firewall.service
Wants=network-online.target
Requires=webserver-network.service webserver-firewall.service

[Container]
GlobalArgs=--runtime=runc
Image=docker.io/library/caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
Pull=never
ContainerName=caddy
Network=webserver.network
Volume=/opt/webserver/current/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=caddy-data.volume:/data
Volume=caddy-config.volume:/config
PublishPort=80:80/tcp
PublishPort=443:443/tcp
PublishPort=443:443/udp
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=all
AddCapability=NET_BIND_SERVICE
Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=32m,mode=1777
LogDriver=journald
PodmanArgs=--memory=512m --cpu-shares=1024 --pids-limit=128
HealthCmd=/usr/bin/curl --silent --output /dev/null --show-error --fail --max-time 5 http://localhost:2019/config/
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=120
TimeoutStopSec=30
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
