[Unit]
Description=josephduffy.co.uk Swift server
After=network-online.target webserver-network.service webserver-firewall.service
Wants=network-online.target
Requires=webserver-network.service webserver-firewall.service
ConditionPathExists=/var/lib/webserver-deploy/images/josephduffy-co-uk-swift/enabled

[Container]
GlobalArgs=--runtime=runc
Image=localhost/josephduffy-co-uk-swift:production
Pull=never
ContainerName=josephduffy-co-uk-swift
Network=webserver.network
EnvironmentFile=/etc/webserver/josephduffy-co-uk-swift.env
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=all
User=1001:1001
Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=64m,mode=1777
LogDriver=journald
PodmanArgs=--memory=4g --cpu-shares=512 --pids-limit=256
HealthCmd=/usr/bin/curl --head --silent --output /dev/null --show-error --fail --max-time 5 http://localhost:8080/
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=kill

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=120
TimeoutStopSec=30
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
