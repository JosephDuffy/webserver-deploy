# Managed by webserver-deploy during migration. Port 22 remains public only until the administrator
# explicitly completes the lock-down checklist.
Port 22
Port 2222
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PubkeyAuthentication yes
# These accounts use Tailscale SSH, never OpenSSH.
DenyUsers webserver-image-deploy webserver-config-deploy
