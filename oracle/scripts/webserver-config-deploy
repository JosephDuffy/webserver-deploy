#!/usr/bin/env bash

set -Eeuo pipefail

# shellcheck disable=SC1091
source /usr/local/lib/webserver-deploy-common.sh

require_root
[[ $# -eq 1 ]] || die "usage: webserver-config-deploy <40 lowercase hex commit>"
validate_commit "$1" || die "invalid configuration commit"
readonly commit=$1

require_supported_host
require_runtime_capabilities
[[ -f $ENV_FILE && -s $ENV_FILE && ! -L $ENV_FILE ]] ||
    die "missing josephduffy-co-uk.env; bootstrap update required"

mkdir -p "$STATE_DIR" "$RELEASE_ROOT"
exec 9>"$STATE_DIR/deploy.lock"
flock --exclusive 9

temporary_root=$(mktemp -d)
release_staging=''
previous=''
rollback_required=false
cleanup_temporary_files() {
    rm -rf "$temporary_root"
    if [[ -n $release_staging ]]; then
        rm -rf "$release_staging"
    fi
}
finish() {
    local status=$?
    set +e
    cleanup_temporary_files
    if [[ $status -ne 0 && $rollback_required == true ]]; then
        log "configuration failed; restoring the previous release"
        if [[ -n $previous && -d $previous ]]; then
            activate_release "$previous"
            systemctl restart josephduffy-co-uk.service
            systemctl restart caddy.service
            wait_for_stack_health "$website_image_id" 12 5
            record_history "configuration rollback ${commit}"
        else
            systemctl stop caddy.service josephduffy-co-uk.service
        fi
    fi
    exit "$status"
}
trap finish EXIT
archive="$temporary_root/release.tar.gz"
candidate="$temporary_root/oracle"
target="$RELEASE_ROOT/$commit"
archive_root="webserver-deploy-$commit"

log "downloading configuration commit ${commit}"
curl --fail --silent --show-error --location \
    --proto '=https' --tlsv1.2 \
    "https://codeload.github.com/JosephDuffy/webserver-deploy/tar.gz/${commit}" \
    --output "$archive"
mkdir -p "$candidate"
tar \
    --extract \
    --gzip \
    --file "$archive" \
    --directory "$candidate" \
    --strip-components=2 "$archive_root/oracle"

"$candidate/scripts/validate-release" "$candidate"

if [[ ! -e $target ]]; then
    release_staging=$(mktemp -d "$RELEASE_ROOT/.${commit}.XXXXXX")
    cp -a "$candidate/." "$release_staging/"
    chown -R root:root "$release_staging"
    mv "$release_staging" "$target"
    release_staging=''
fi
"$target/scripts/validate-release" "$target"

if [[ -L $CURRENT_RELEASE ]]; then
    previous=$(readlink -f "$CURRENT_RELEASE")
fi

website_changed=true
caddy_changed=true
if [[ -n $previous && -d $previous ]]; then
    website_changed=false
    caddy_changed=false
    cmp -s "$previous/quadlet/josephduffy-co-uk.container" "$target/quadlet/josephduffy-co-uk.container" || website_changed=true
    cmp -s "$previous/quadlet/webserver.network" "$target/quadlet/webserver.network" || { website_changed=true; caddy_changed=true; }
    cmp -s "$previous/quadlet/caddy.container" "$target/quadlet/caddy.container" || caddy_changed=true
    cmp -s "$previous/quadlet/caddy-data.volume" "$target/quadlet/caddy-data.volume" || caddy_changed=true
    cmp -s "$previous/quadlet/caddy-config.volume" "$target/quadlet/caddy-config.volume" || caddy_changed=true
    cmp -s "$previous/Caddyfile" "$target/Caddyfile" || caddy_changed=true
fi

podman image exists "$WEBSITE_LOCAL_IMAGE" ||
    die "no promoted website image exists; bootstrap update required"
website_image_id=$(podman image inspect --format '{{.Id}}' "$WEBSITE_LOCAL_IMAGE")
readonly website_image_id

activate_release() {
    local release=$1
    atomic_symlink "$release" "$CURRENT_RELEASE"
    install_managed_files "$release"
    systemctl daemon-reload
    systemctl restart "$FIREWALL_SERVICE"
}

restart_changed_services() {
    if [[ $website_changed == true ]]; then
        systemctl restart josephduffy-co-uk.service
    else
        systemctl start josephduffy-co-uk.service
    fi
    if [[ $caddy_changed == true ]]; then
        systemctl restart caddy.service
    else
        systemctl start caddy.service
    fi
}

rollback_required=true
activate_release "$target"
if restart_changed_services && wait_for_stack_health "$website_image_id"; then
    printf '%s\n' "$commit" >"$STATE_DIR/current-config-commit"
    chmod 0600 "$STATE_DIR/current-config-commit"
    record_history "configuration deployed ${commit}"
    rollback_required=false
    log "configuration deployment succeeded"
    exit 0
fi

die "configuration deployment failed its startup or health check"
