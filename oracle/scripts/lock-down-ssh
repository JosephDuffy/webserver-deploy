#!/usr/bin/env bash

set -Eeuo pipefail

# shellcheck disable=SC1091
source /usr/local/lib/webserver-deploy-common.sh

require_root

[[ $# -eq 3 ]] || die "usage: webserver-lock-down-ssh --admin-tested --workflows-tested --serial-console-tested"
[[ $1 == --admin-tested && $2 == --workflows-tested && $3 == --serial-console-tested ]] ||
    die "complete and acknowledge the admin, workflow, and serial-console tests in the documented order"

require_command tailscale
[[ $(tailscale status --json | jq -r '.BackendState') == Running ]] ||
    die "Tailscale is not connected"

install -o root -g root -m 0644 \
    "$CURRENT_RELEASE/host/sshd_config.locked-down" \
    /etc/ssh/sshd_config.d/60-webserver.conf
/usr/sbin/sshd -t

mapfile -t configured_ports < <(/usr/sbin/sshd -T | awk '$1 == "port" { print $2 }' | sort -u)
[[ ${#configured_ports[@]} -eq 1 && ${configured_ports[0]} == 2222 ]] ||
    die "OpenSSH still has another Port directive (${configured_ports[*]}); remove it manually before retrying"

systemctl restart ssh.service
install -o root -g root -m 0600 /dev/null "$STATE_DIR/ssh-locked-down"
systemctl restart "$FIREWALL_SERVICE"
record_history "public OpenSSH port 22 disabled"

log "OpenSSH now listens only on port 2222 and the managed firewall blocks public port 22"
log "remove the temporary public TCP/22 ingress rule from the Oracle VCN/NSG now"
