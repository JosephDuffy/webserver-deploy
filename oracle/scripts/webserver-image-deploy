#!/usr/bin/env bash

set -Eeuo pipefail

# This installed file is root-owned. Do not source code from the active release:
# a configuration rollback must not change the security boundary of this command.
# shellcheck disable=SC1091
source /usr/local/lib/webserver-deploy-common.sh
# shellcheck disable=SC1091
source /usr/local/lib/webserver-deploy-image-transaction.sh

require_root
[[ $# -eq 2 ]] ||
    die "usage: webserver-image-deploy <target> sha256:<64 lowercase hex characters>"
load_deployment_target "$1"
validate_digest "$2" || die "invalid image digest"
readonly requested_target=$1
readonly digest=$2

require_supported_host
require_runtime_capabilities
require_public_ipv6_route
[[ -f $DEPLOY_ENV_FILE && -s $DEPLOY_ENV_FILE && ! -L $DEPLOY_ENV_FILE ]] ||
    die "missing environment for ${requested_target}; bootstrap update required"

mkdir -p "$STATE_DIR" "$DEPLOY_STATE_DIR"
exec 9>"$STATE_DIR/deploy.lock"
flock --exclusive 9

readonly remote_image="${DEPLOY_IMAGE}@${digest}"
previous_image_id=''
previous_digest=''
rollback_required=false
target_was_enabled=false
deployment_target_is_enabled && target_was_enabled=true

finish() {
    local status=$?
    set +e
    if [[ $status -ne 0 && $rollback_required == true ]]; then
        log "image deployment failed for ${requested_target}; restoring its previous local image"
        restore_previous_image \
            "$previous_image_id" "$DEPLOY_LOCAL_IMAGE" "$DEPLOY_SERVICE" \
            "$DEPLOY_CONTAINER" "$DEPLOY_HOSTNAME" "$DEPLOY_HEALTH_PATH"
        if [[ $target_was_enabled == false ]]; then
            rm -f "$DEPLOY_STATE_DIR/enabled"
        fi
        record_history "image rollback ${requested_target} ${digest}"
    fi
    exit "$status"
}
trap finish EXIT

if [[ $target_was_enabled == true ]]; then
    if podman image exists "$DEPLOY_LOCAL_IMAGE"; then
        previous_image_id=$(podman image inspect --format '{{.Id}}' "$DEPLOY_LOCAL_IMAGE")
    fi
    if [[ -f $DEPLOY_STATE_DIR/current-digest ]]; then
        previous_digest=$(<"$DEPLOY_STATE_DIR/current-digest")
    fi
fi

log "verifying the GitHub attestation for ${requested_target} ${digest}"
verify_attestation_from_stdin "$DEPLOY_REPOSITORY" "$DEPLOY_IMAGE" "$digest"

log "pulling the exact OCI index digest"
podman pull "$remote_image"
[[ $(image_platform "$remote_image") == linux/arm64 ]] ||
    die "the selected image is not linux/arm64"
candidate_image_id=$(podman image inspect --format '{{.Id}}' "$remote_image")
readonly candidate_image_id

podman tag "$remote_image" "$DEPLOY_LOCAL_IMAGE"
enable_deployment_target
rollback_required=true

if systemctl restart "$DEPLOY_SERVICE" &&
    wait_for_target_deployment \
        "$DEPLOY_CONTAINER" "$DEPLOY_HOSTNAME" "$DEPLOY_HEALTH_PATH" "$candidate_image_id"; then
    temporary=$(mktemp "$DEPLOY_STATE_DIR/current-digest.XXXXXX")
    printf '%s\n' "$digest" >"$temporary"
    chmod 0600 "$temporary"
    if [[ -n $previous_digest ]]; then
        printf '%s\n' "$previous_digest" >"$DEPLOY_STATE_DIR/previous-digest"
        chmod 0600 "$DEPLOY_STATE_DIR/previous-digest"
    fi
    mv -f "$temporary" "$DEPLOY_STATE_DIR/current-digest"
    rollback_required=false
    record_history "image deployed ${requested_target} ${digest}" ||
        log "warning: could not append deployment history"
    log "image deployment succeeded for ${requested_target}"
    exit 0
fi

die "image deployment failed its startup or health check for ${requested_target}"
